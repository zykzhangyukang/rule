# ============================================================
# OpenClash 覆写模块（私有，含秘钥）
# 使用：复制为 my-secrets.conf 并填入真实值。my-secrets.conf 已被 .gitignore 忽略，不要提交。
# 导入：运行状态页 -> Overwrite Module -> 添加新模块 -> 上传本文件，
#       匹配配置选 all，打开开关后重启插件才生效。
# 作用：把秘钥单独放在这里，公开的 config/me/my-configdns.yaml 里就不用出现订阅链接、账号密码和 token。
# 格式：必须有 [YAML] 段头。其中的内容按「深度合并」写入运行配置，
#       键名后缀决定合并方式：! 整块替换；+ 追加到数组末尾；无后缀是递归合并（数组则整体替换）。
# ============================================================
[YAML]

# ---- 1. 机场订阅 ----
# proxy-providers! 带 !：整块替换主配置里的 proxy-providers，
# 所以主配置里的占位订阅（Airport1）会被丢弃，只保留这里的 4 个机场。
# 主配置里的策略组通过 use: [XFLASH] 这类写法引用这里的名称，改名需两边同步。
# url 填各机场的订阅链接；proxy: 直连 表示下载订阅时不经代理。
proxy-providers!:
  XFLASH:
    url: "https://example.com/your-subscription-url"
    type: http
    interval: 86400          # 订阅更新间隔，单位秒（86400 = 1 天）
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300          # 健康检查间隔，单位秒
      expected-status: 204
    proxy: 直连
  DAGEYUN:
    url: "https://example.com/your-subscription-url"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      expected-status: 204
    proxy: 直连
  PAIPIAO:
    url: "https://example.com/your-subscription-url"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      expected-status: 204
    proxy: 直连
  LIANGXIN:
    url: "https://example.com/your-subscription-url"
    type: http
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      expected-status: 204
    proxy: 直连

# ---- 2. 自建节点（家宽 socks5）----
# proxies+ 带 +：追加到主配置 proxies 数组末尾，不会覆盖已有节点。
# dialer-proxy：连接此节点前先经过名为「家宽前置」的策略组（链式代理），该策略组需在主配置中存在。
proxies+:
  - name: 美国家宽
    type: socks5
    server: 127.0.0.1          # 替换为真实服务器地址
    port: 9004
    username: your_username
    password: your_password
    dialer-proxy: 家宽前置

# ---- 3. 节点域名解析用的 DoH ----
# proxy-server-nameserver-policy：仅用于解析「代理节点的域名」，
# 且只有主配置里 proxy-server-nameserver 不为空时才生效（Mihomo 文档）。
# 无 ! 或 +，是深度合并（OpenClash 重启时自动执行）：Hash 递归合并，新域名会被新增；
# 但同名域名对应的地址列表（数组）会被整体替换，不是逐项合并。
# 域名后面是各机场提供的 DoH 地址，路径末尾带个人 token，因此放在这里。
# #skip-cert-verify=true 表示跳过 TLS 证书校验。
dns:
  proxy-server-nameserver-policy:
    # xflash
    "+.dongchedi.com":
      - https://doh.example.com/dns-query/YOUR_TOKEN#skip-cert-verify=true
    # 大哥云
    "+.bilibilll.com":
      - https://doh.example.com/dns-query/YOUR_TOKEN
      - https://doh.example.com/dns-query/YOUR_TOKEN
    "+.aixifan256.com":
      - https://doh.example.com/dns-query/YOUR_TOKEN
      - https://doh.example.com/dns-query/YOUR_TOKEN
    "+.quandao.com":
      - https://doh.example.com/dns-query/YOUR_TOKEN
      - https://doh.example.com/dns-query/YOUR_TOKEN
    "+.ydlingshi.com":
      - https://doh.example.com/dns-query/YOUR_TOKEN
      - https://doh.example.com/dns-query/YOUR_TOKEN
    "+.gttysd.com":
      - https://doh.example.com/dns-query/YOUR_TOKEN
      - https://doh.example.com/dns-query/YOUR_TOKEN
